"short EngineStep component description"
component EngineStep
  cmd = BlockComponents.Sources.Step(height = 200, offset = 0.5) {^cmd}
  load = RotationalComponents.Components.Inertia(J = 1) {^load}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
  engine = MyCar.Engine() {^engine}
relations
  connect(engine.spline, load.spline_a) {^id5}
  connect(engine.spline1, mounts.spline) {^id6}
  connect(cmd.y, engine.realinput) {^id7}
  initial engine.lag.x = 0
  initial load.phi = 0
  initial load.w = 0
end
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "cmd": {
      "Dyad": {"placement": {"diagram": {"x1": 140, "x2": 240, "y1": 450, "y2": 550}}}
    },
    "load": {
      "Dyad": {"placement": {"diagram": {"x1": 610, "x2": 710, "y1": 450, "y2": 550}}}
    },
    "mounts": {
      "Dyad": {"placement": {"diagram": {"x1": 310, "x2": 410, "y1": 670, "y2": 770}}}
    },
    "engine": {
      "Dyad": {"placement": {"diagram": {"x1": 310, "x2": 410, "y1": 450, "y2": 550}}}
    },
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end