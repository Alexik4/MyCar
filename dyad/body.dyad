"""
Car body on a flat road: tractive force in at the flange, resisted by aerodynamic drag and rolling
resistance.
"""
component Body
  "Tractive force from the driveline"
  flange = Flange() {^flange}
  mass = TranslationalComponents.Components.Mass(m = m) {^mass}
  # A negative nominal force makes the source a load; ForceDirection = false gives the v*|v| form,
  # so drag opposes motion in both directions.
  drag = TranslationalComponents.Sources.QuadraticSpeedDependentForce(ForceDirection = false, v_nominal = v_nominal, f_nominal = -0.5 * rho * CdA * v_nominal ^ 2) {^drag}
  rolling = TranslationalComponents.Components.RollingResistance(fWeight = m * g) {^rolling}
  cr_const = BlockComponents.Sources.Constant(k = f_r) {^cr_const}
  "Flat road: tan(alpha) = 0"
  incl_const = BlockComponents.Sources.Constant(k = 0) {^incl_const}
  ground = TranslationalComponents.Components.Fixed() {^ground}
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400
  "Aerodynamic drag area, Cd * A"
  parameter CdA::Area = 0.63
  "Air density"
  parameter rho::Density = 1.2
  "Rolling resistance coefficient"
  parameter f_r::Real = 0.012
  "Gravitational acceleration"
  parameter g::Acceleration = 9.80665
  "Speed at which the drag force is specified"
  parameter v_nominal::Velocity = 30
relations
  connect(drag.flange, mass.flange_a) {^id8}
  connect(rolling.flange, mass.flange_a) {^id9}
  connect(rolling.support, ground.flange) {^id10}
  connect(cr_const.y, rolling.cr) {^id11}
  connect(incl_const.y, rolling.inclination) {^id12}
  connect(drag.support, ground.flange) {^id13}
  connect(drag.flange, flange) {^id14}
metadata {
